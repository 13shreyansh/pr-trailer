+
+def _format_lib_section(libraries: Iterable[str] | None) -> str:
+    """Render a ``lib_deps`` section for ``platformio.ini`` if needed."""
+
+    if not libraries:
+        return ""
+
+    unique: List[str] = []
+    for entry in libraries:
+        if not entry:
+            continue
+        if entry not in unique:
+            unique.append(entry)
+
+    if not unique:
+        return ""
+
+    lines = ["lib_deps ="]
+    lines.extend(f"  {name}" for name in unique)
+    return "\n".join(lines)
 
