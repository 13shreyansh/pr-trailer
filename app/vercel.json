{
  "functions": {"api/bridge.js": {"maxDuration": 60}},
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}],
  "rewrites": [{"source":"/api/:endpoint","destination":"/api/bridge?endpoint=:endpoint"},{"source":"/workspace/:path*","destination":"/index.html"}]
}
