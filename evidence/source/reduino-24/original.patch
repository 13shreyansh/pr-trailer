+            "PlatformIO will download it automatically if it's missing.",
+            file=sys.stderr,
+        )
+    cpp = emit(program)
 
     tmp = pathlib.Path(tempfile.mkdtemp(prefix="reduino-pio-"))
-    write_project(tmp, cpp, port=port)
